# Render Environment Variables (Copy & paste into Render Dashboard -> Environment)

# 1. MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://prince:prince55833@cluster1.niqvdam.mongodb.net/msec_sip_arena?retryWrites=true&w=majority&appName=Cluster1

# 2. JWT Secret for Auth Token Signing
JWT_SECRET=msec-sip-arena-production-jwt-secret-key-2026

# 3. Allowed Frontend Origin(s) (Comma-separated or your Vercel URL)
CLIENT_ORIGIN=https://msec-sip.vercel.app/

# 4. Auto-seed initial venues & tribes on first boot if DB is empty
SEED_ON_START=true

# 5. Node Environment
NODE_ENV=production
